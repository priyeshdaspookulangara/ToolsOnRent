<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.toolsonrent.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboardFragment_to_toolListFragment"
            app:destination="@id/toolListFragment" />
    </fragment>

    <fragment
        android:id="@+id/toolListFragment"
        android:name="com.example.toolsonrent.ui.toollistscreen.ToolListFragment"
        android:label="Tools Inventory"
        tools:layout="@layout/fragment_tool_list" >
        <action
            android:id="@+id/action_toolListFragment_to_addToolFragment"
            app:destination="@id/addToolFragment" />
            <!-- Add enter/exit animations here if desired -->
    </fragment>

    <fragment
        android:id="@+id/addToolFragment"
        android:name="com.example.toolsonrent.ui.addtool.AddToolFragment"
        android:label="Add New Tool"
        tools:layout="@layout/fragment_add_tool" />

</navigation>
