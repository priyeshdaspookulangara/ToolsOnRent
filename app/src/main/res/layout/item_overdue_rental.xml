<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    app:cardElevation="2dp"
    app:strokeColor="@android:color/holo_red_light"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/textViewToolNameOverdueItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadline6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/textViewDaysOverdueItem"
            android:layout_marginEnd="8dp"
            tools:text="Power Drill XL" />

        <TextView
            android:id="@+id/textViewCustomerNameOverdueItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewToolNameOverdueItem"
            app:layout_constraintEnd_toEndOf="@id/textViewToolNameOverdueItem"
            android:layout_marginTop="4dp"
            tools:text="Rented by: Jane Smith" />

        <TextView
            android:id="@+id/textViewDueDateOverdueItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBody2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewCustomerNameOverdueItem"
            app:layout_constraintEnd_toEndOf="@id/textViewCustomerNameOverdueItem"
            android:layout_marginTop="4dp"
            tools:text="Was Due: 15/01/2023" />

        <TextView
            android:id="@+id/textViewDaysOverdueItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBody1"
            android:textStyle="bold"
            android:textColor="@android:color/holo_red_dark"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/textViewToolNameOverdueItem"
            app:layout_constraintBottom_toBottomOf="@id/textViewDueDateOverdueItem"
            tools:text="10 Days Overdue" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
