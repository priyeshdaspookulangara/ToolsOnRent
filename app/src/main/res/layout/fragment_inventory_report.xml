<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.reports.inventory.InventoryReportFragment">

    <TextView
        android:id="@+id/textViewInventoryReportTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Inventory Report"
        android:textAppearance="?attr/textAppearanceHeadline5"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Summary Counts Section -->
    <TextView
        android:id="@+id/textViewTotalToolsInvLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total Tools:"
        android:textAppearance="?attr/textAppearanceSubtitle1"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewInventoryReportTitle"/>

    <TextView
        android:id="@+id/textViewTotalToolsInvValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="0"
        android:textAppearance="?attr/textAppearanceSubtitle1"
        android:textStyle="bold"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/textViewTotalToolsInvLabel"
        app:layout_constraintBaseline_toBaselineOf="@id/textViewTotalToolsInvLabel"/>

    <TextView
        android:id="@+id/textViewAvailableToolsInvLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Available:"
        android:textAppearance="?attr/textAppearanceBody1"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@id/textViewTotalToolsInvLabel"
        app:layout_constraintTop_toBottomOf="@id/textViewTotalToolsInvLabel"/>

    <TextView
        android:id="@+id/textViewAvailableToolsInvValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="0"
        android:textAppearance="?attr/textAppearanceBody1"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/textViewAvailableToolsInvLabel"
        app:layout_constraintBaseline_toBaselineOf="@id/textViewAvailableToolsInvLabel"
        android:layout_marginStart="8dp"/>

    <TextView
        android:id="@+id/textViewRentedToolsInvLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rented:"
        android:textAppearance="?attr/textAppearanceBody1"
        app:layout_constraintStart_toStartOf="@id/textViewAvailableToolsInvValue"
        android:layout_marginStart="24dp"
        app:layout_constraintBaseline_toBaselineOf="@id/textViewAvailableToolsInvLabel"/>
        <!-- Aligned with Available count, to its right -->

    <TextView
        android:id="@+id/textViewRentedToolsInvValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="0"
        android:textAppearance="?attr/textAppearanceBody1"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/textViewRentedToolsInvLabel"
        app:layout_constraintBaseline_toBaselineOf="@id/textViewRentedToolsInvLabel"
        android:layout_marginStart="8dp"/>

    <!-- Detailed List Section -->
     <TextView
        android:id="@+id/textViewAllToolsSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="All Tools Details"
        android:textAppearance="?attr/textAppearanceHeadline6"
        android:paddingTop="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/textViewAvailableToolsInvLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewInventoryReport"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/textViewAllToolsSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_tool"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/textViewNoToolsInventory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No tools found in inventory."
        android:textAppearance="?attr/textAppearanceSubtitle1"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/textViewAllToolsSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible"/>

</androidx.constraintlayout.widget.ConstraintLayout>
