<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/imageViewToolItemRow"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:scaleType="centerCrop"
        tools:srcCompat="@tools:sample/backgrounds/scenic" /> <!-- Placeholder -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp">

        <TextView
            android:id="@+id/textViewItemUnitIdUserRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            tools:text="DRILL-XYZ-001" />

        <TextView
            android:id="@+id/textViewItemStatusRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBody2"
            tools:text="Status: Available" />

        <TextView
            android:id="@+id/textViewItemConditionRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBody2"
            tools:text="Condition: Good" />

        <TextView
            android:id="@+id/textViewItemAssetTagRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceCaption"
            tools:text="Asset: #12345"
            android:visibility="gone"/> <!-- Initially gone, can be made visible if data exists -->

    </LinearLayout>

    <ImageView
        android:id="@+id/imageViewItemMoreOptions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_more_vert"
        app:tint="?android:attr/textColorSecondary"
        android:contentDescription="More options for item"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"/> <!-- For future actions like 'Edit', 'View History' -->

</LinearLayout>
