<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/textViewToolNameActiveItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadline6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/buttonMarkReturnedItem"
            android:layout_marginEnd="8dp"
            tools:text="Tool Name Here" />

        <TextView
            android:id="@+id/textViewToolInstanceIdentifierActiveItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceSubtitle2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewToolNameActiveItem"
            app:layout_constraintEnd_toEndOf="@id/textViewToolNameActiveItem"
            android:layout_marginTop="2dp"
            tools:text="SN: 12345XYZ" />

        <TextView
            android:id="@+id/textViewCustomerNameActiveItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewToolInstanceIdentifierActiveItem"
            app:layout_constraintEnd_toEndOf="@id/textViewToolNameActiveItem"
            android:layout_marginTop="4dp"
            tools:text="Customer: John Doe" />

        <!-- ImageView for the tool type -->
        <ImageView
            android:id="@+id/imageViewToolTypeActiveItem"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            tools:srcCompat="@drawable/ic_image_placeholder"
            android:contentDescription="@string/tool_image_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewCustomerNameActiveItem" />

        <TextView
            android:id="@+id/textViewRentalDateActiveItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBody2"
            app:layout_constraintStart_toEndOf="@id/imageViewToolTypeActiveItem"
            app:layout_constraintTop_toTopOf="@id/imageViewToolTypeActiveItem"
            android:layout_marginStart="8dp"
            tools:text="Rented: 01/01/2023"/>

        <TextView
            android:id="@+id/textViewDueDateActiveItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/imageViewToolTypeActiveItem"
            app:layout_constraintTop_toBottomOf="@id/textViewRentalDateActiveItem"
            android:layout_marginTop="4dp"
            android:layout_marginStart="8dp"
            tools:text="Due: 10/01/2023" />

        <Button
            android:id="@+id/buttonMarkReturnedItem"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Return"
            app:icon="@drawable/ic_baseline_check_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/textViewCustomerNameActiveItem"/>
            <!-- Aligns button vertically with Tool Name and Customer Name block -->

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
