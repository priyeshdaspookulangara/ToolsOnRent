<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.tool.edit.EditToolFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Tool Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textFieldLayoutToolNameEdit"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:hint="Tool Name">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextToolNameEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tool Description -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textFieldLayoutToolDescriptionEdit"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/textFieldLayoutToolNameEdit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:hint="Description (Optional)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextToolDescriptionEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Rental Price -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textFieldLayoutRentalPriceEdit"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/textFieldLayoutToolDescriptionEdit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:hint="Rental Price per Day">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextRentalPriceEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Total Quantity -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textFieldLayoutTotalQuantityEdit"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/textFieldLayoutRentalPriceEdit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:hint="Total Quantity">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextTotalQuantityEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Currently Available Quantity Display -->
        <TextView
            android:id="@+id/textViewCurrentAvailableQuantityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Currently Available:"
            android:textAppearance="?attr/textAppearanceBody1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textFieldLayoutTotalQuantityEdit"/>

        <TextView
            android:id="@+id/textViewCurrentAvailableQuantityEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBody1"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/textViewCurrentAvailableQuantityLabel"
            app:layout_constraintBaseline_toBaselineOf="@id/textViewCurrentAvailableQuantityLabel"
            android:layout_marginStart="8dp"
            tools:text="0"/>

        <!-- Availability Switch (REMOVED) -->
        <!--
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAvailabilityEdit"
            ... />
        -->

        <!-- Image Preview -->
        <ImageView
            android:id="@+id/imageViewToolPreviewEdit"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="16dp"
            android:src="@android:drawable/ic_menu_gallery"
            android:scaleType="centerCrop"
            android:contentDescription="Tool Image Preview"
            app:layout_constraintTop_toBottomOf="@id/textViewCurrentAvailableQuantityLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Select Image Button -->
        <Button
            android:id="@+id/buttonSelectImageEdit"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Select Image"
            app:layout_constraintTop_toBottomOf="@id/imageViewToolPreviewEdit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/buttonRemoveImageEdit"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Remove Image"
            android:visibility="gone"
            app:icon="@android:drawable/ic_menu_delete"
            app:iconTint="?attr/colorError"
            android:textColor="?attr/colorError"
            app:strokeColor="?attr/colorError"
            app:layout_constraintTop_toBottomOf="@id/buttonSelectImageEdit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible"/>

        <!-- Save Changes Button -->
        <Button
            android:id="@+id/buttonSaveChangesTool"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Save Changes"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/buttonRemoveImageEdit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Delete Tool Button -->
        <Button
            android:id="@+id/buttonDeleteTool"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Delete Tool"
            android:textColor="?attr/colorError"
            app:strokeColor="?attr/colorError"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/buttonSaveChangesTool"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
