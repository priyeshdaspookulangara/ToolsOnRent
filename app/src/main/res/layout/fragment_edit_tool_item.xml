<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.toolitem.EditToolItemFragment">
    <!-- Assuming new fragment class -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textViewEditItemHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadline5"
            tools:text="Edit Item: DRL-XYZ-001"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imageViewItemEditPhoto"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_placeholder_item" />
                <!-- Assumes ic_placeholder_item.xml exists -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp">
                <Button
                    android:id="@+id/buttonChangeItemEditPhoto"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Set/Change Image" />
                <Button
                    android:id="@+id/buttonRemoveItemEditPhoto"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorError"
                    android:text="Remove Image"
                    android:visibility="gone"/> <!-- Visible if image exists -->
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textFieldLayoutItemEditUnitIdUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Item User ID (e.g., DRL-001)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextItemEditUnitIdUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textFieldLayoutItemEditSerialNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Serial Number (Optional)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextItemEditSerialNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textFieldLayoutItemEditAssetTag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Asset Tag (Optional)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextItemEditAssetTag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Status" style="?android:attr/textAppearanceLabelSmall" android:layout_marginTop="16dp"/>
        <Spinner
            android:id="@+id/spinnerItemEditStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Condition" style="?android:attr/textAppearanceLabelSmall" android:layout_marginTop="8dp"/>
        <Spinner
            android:id="@+id/spinnerItemEditCondition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textFieldLayoutItemEditLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Location">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextItemEditLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textFieldLayoutItemEditPurchasePrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Purchase Price (Optional)"
            app:prefixText="$">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextItemEditPurchasePrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Purchase Date" style="?android:attr/textAppearanceLabelSmall" android:layout_marginTop="16dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/textViewItemEditPurchaseDate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" tools:text="2023-01-15" android:textAppearance="?android:attr/textAppearanceMedium"/>
            <Button android:id="@+id/buttonItemEditPurchaseDate" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Set Date" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Warranty Expiry Date" style="?android:attr/textAppearanceLabelSmall" android:layout_marginTop="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/textViewItemEditWarrantyExpiryDate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" tools:text="2025-01-15" android:textAppearance="?android:attr/textAppearanceMedium"/>
            <Button android:id="@+id/buttonItemEditWarrantyExpiryDate" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Set Date" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textFieldLayoutItemEditNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Notes (Optional)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextItemEditNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top"/>
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/buttonSaveItemChanges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Save Item Changes"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
