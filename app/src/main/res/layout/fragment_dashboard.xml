<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.dashboard.DashboardFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Key Metrics Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Key Metrics"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:layout_marginBottom="16dp"/> <!-- Increased bottom margin -->

        <LinearLayout
            android:id="@+id/linearLayoutKpiCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:baselineAligned="false">

            <include
                android:id="@+id/includeDueToolReturnsCard"
                layout="@layout/kpi_card_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                />

            <include
                android:id="@+id/includeTotalTransactionsCard"
                layout="@layout/kpi_card_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                />
        </LinearLayout>

        <!-- Available Tools Metric -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/textViewAvailableCountLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Tools Available:"
                android:textAppearance="?attr/textAppearanceBody1"/>
            <TextView
                android:id="@+id/textViewAvailableCountValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBody1"
                android:textStyle="bold"
                tools:text="0"/>
        </LinearLayout>

        <!-- Rented Tools Metric -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/textViewRentedCountLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Tools Rented:"
                android:textAppearance="?attr/textAppearanceBody1"/>
            <TextView
                android:id="@+id/textViewRentedCountValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBody1"
                android:textStyle="bold"
                tools:text="0"/>
        </LinearLayout>

        <!-- Overdue Tools Metric (Placeholder) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp"> <!-- Increased bottom margin for section end -->
            <TextView
                android:id="@+id/textViewOverdueCountLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Tools Overdue:"
                android:textAppearance="?attr/textAppearanceBody1"/>
            <TextView
                android:id="@+id/textViewOverdueCountValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBody1"
                android:textStyle="bold"
                tools:text="0"/>
        </LinearLayout>

        <!-- Daily Profit Metric -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/textViewDailyProfitLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Today's Profit:"
                android:textAppearance="?attr/textAppearanceBody1"/>
            <TextView
                android:id="@+id/textViewDailyProfitValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBody1"
                android:textStyle="bold"
                tools:text="$0.00"/>
        </LinearLayout>

        <!-- Monthly Profit Metric -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp"> <!-- Increased bottom margin for section end -->
            <TextView
                android:id="@+id/textViewMonthlyProfitLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="This Month's Profit:"
                android:textAppearance="?attr/textAppearanceBody1"/>
            <TextView
                android:id="@+id/textViewMonthlyProfitValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBody1"
                android:textStyle="bold"
                tools:text="$0.00"/>
        </LinearLayout>

        <!-- Quick Access Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Access"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonGoToToolList"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Tools"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonManageCustomersDashboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Customers"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonManageReturnsDashboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Returns / Active Rentals"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonViewOverdueReportDashboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Overdue Rentals Report"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonCustomerHistoryReportDashboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customer Rental History Report"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonToolHistoryReportDashboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tool Rental History Report"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonInventoryReportDashboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inventory Report"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonProfitLossReportDashboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profit &amp; Loss Report"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonAddNewToolDashboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add New Tool"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonAddNewCustomerDashboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add New Customer"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonStartNewRentalDashboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start New Rental"
            android:layout_marginBottom="24dp"/> <!-- Increased margin for section end -->

        <!-- Upcoming Returns / Calendar Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upcoming Returns"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:layout_marginBottom="8dp"/>

        <com.prolificinteractive.materialcalendarview.MaterialCalendarView
            android:id="@+id/materialCalendarDashboard"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            app:mcv_showOtherDates="all"
            app:mcv_selectionMode="single"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
