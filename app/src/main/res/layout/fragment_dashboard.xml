<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.dashboard.DashboardFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Key Metrics Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Key Metrics"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:layout_marginBottom="16dp"/> <!-- Increased bottom margin -->

        <LinearLayout
            android:id="@+id/linearLayoutKpiCardsRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:baselineAligned="false">

            <include
                android:id="@+id/includeDueToolReturnsCard"
                layout="@layout/kpi_card_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/includeTotalTransactionsCard"
                layout="@layout/kpi_card_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayoutKpiCardsRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:baselineAligned="false">

            <include
                android:id="@+id/includeAvailableToolsCard"
                layout="@layout/kpi_card_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/includeRentedToolsCard"
                layout="@layout/kpi_card_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayoutKpiCardsRow3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:baselineAligned="false">

            <include
                android:id="@+id/includeOverdueToolsCard"
                layout="@layout/kpi_card_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/includeDailyProfitCard"
                layout="@layout/kpi_card_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayoutKpiCardsRow4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:baselineAligned="false">

            <include
                android:id="@+id/includeMonthlyProfitCard"
                layout="@layout/kpi_card_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <!-- Add a spacer view to keep the single card to the left, or add another card here in future -->
            <View
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- Upcoming Returns / Calendar Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upcoming Returns"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:layout_marginBottom="8dp"/>

        <com.prolificinteractive.materialcalendarview.MaterialCalendarView
            android:id="@+id/materialCalendarDashboard"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            app:mcv_showOtherDates="all"
            app:mcv_selectionMode="single"
            android:layout_marginBottom="24dp"/> <!-- Increased margin for section end -->


        <!-- Quick Access Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Access"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonGoToToolList"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Tools"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonManageCustomersDashboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Customers"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonManageReturnsDashboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Returns / Active Rentals"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonViewOverdueReportDashboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Overdue Rentals Report"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonCustomerHistoryReportDashboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customer Rental History Report"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonToolHistoryReportDashboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tool Rental History Report"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonInventoryReportDashboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inventory Report"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonProfitLossReportDashboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profit &amp; Loss Report"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonAddNewToolDashboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add New Tool"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonAddNewCustomerDashboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add New Customer"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonStartNewRentalDashboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start New Rental"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
