<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.dashboard.DashboardFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Key Metrics Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Key Metrics"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:layout_marginBottom="16dp"/> <!-- Increased bottom margin -->

        <!-- Available Tools Metric -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/textViewAvailableCountLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Tools Available:"
                android:textAppearance="?attr/textAppearanceBody1"/>
            <TextView
                android:id="@+id/textViewAvailableCountValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBody1"
                android:textStyle="bold"
                tools:text="0"/>
        </LinearLayout>

        <!-- Rented Tools Metric -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/textViewRentedCountLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Tools Rented:"
                android:textAppearance="?attr/textAppearanceBody1"/>
            <TextView
                android:id="@+id/textViewRentedCountValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBody1"
                android:textStyle="bold"
                tools:text="0"/>
        </LinearLayout>

        <!-- Overdue Tools Metric (Placeholder) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp"> <!-- Increased bottom margin for section end -->
            <TextView
                android:id="@+id/textViewOverdueCountLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Tools Overdue:"
                android:textAppearance="?attr/textAppearanceBody1"/>
            <TextView
                android:id="@+id/textViewOverdueCountValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBody1"
                android:textStyle="bold"
                tools:text="0"/>
        </LinearLayout>

        <!-- Quick Access Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Access"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonGoToToolList"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Tools"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/textViewQuickAccessPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[Add Customer, Start Rental buttons placeholder]"
            android:textAppearance="?attr/textAppearanceCaption"
            android:gravity="center_horizontal"
            android:layout_marginBottom="24dp"/>

        <!-- Upcoming Returns / Calendar Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upcoming Returns"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:layout_marginBottom="8dp"/>

        <FrameLayout
            android:id="@+id/calendarViewContainer"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="#E0E0E0"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Calendar View Placeholder"
                android:textAppearance="?attr/textAppearanceSubtitle1"/>
        </FrameLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
